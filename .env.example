PORT=3001
GEMINI_API_KEY=your_gemini_api_key_here

# Storage: sqlite (default, no setup needed), memory (no persistence), postgres
# PREFERENCE_STORE=sqlite
# DATABASE_PATH=bandsearch.db

# Postgres (only needed when PREFERENCE_STORE=postgres)
# DATABASE_URL=postgresql://user:pass@localhost:5432/bandsearch
# DATABASE_SSL=false

# Turso/libSQL (only needed when PREFERENCE_STORE=turso)
# TURSO_DATABASE_URL=libsql://your-db.turso.io
# TURSO_AUTH_TOKEN=your_turso_auth_token_here

# LangSmith tracing (optional)
# LANGSMITH_API_KEY=your_langsmith_api_key_here
# LANGSMITH_TRACING=true
# LANGSMITH_PROJECT=bandsearch-dev

CORS_ORIGIN=http://localhost:1420
RECOMMENDATION_TIMEOUT_MS=8000
MUSICBRAINZ_TIMEOUT_MS=5000
MUSICBRAINZ_RETRIES=1

# Optional: Brave-backed web research pipeline (niche discovery via search snippets + MB verify)
# RECOMMENDATION_PIPELINE=research
# BRAVE_API_KEY=your_brave_search_api_key
# RESEARCH_MAX_INITIAL_SEARCHES=6
# RESEARCH_MAX_REFLECTION_SEARCHES=4
# RESEARCH_TOTAL_SEARCH_BUDGET=10
# RESEARCH_TIMEOUT_MS=25000
# RESEARCH_TARGET_VERIFIED_CANDIDATES=8
