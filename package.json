{
  "name": "bandsearch",
  "version": "0.4.0",
  "private": true,
  "description": "Bandsearch monorepo foundation",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=26"
  },
  "workspaces": [
    "apps/*",
    "services/*",
    "shared/*"
  ],
  "scripts": {
    "start": "tsx services/api/src/server.ts",
    "dev": "tsx services/api/src/server.ts",
    "desktop": "npm run tauri:dev --workspace @bandsearch/desktop",
    "migrate": "npm run migrate --workspace @bandsearch/api",
    "lint:root": "eslint eslint.config.ts playwright.config.ts \"tests/e2e/**/*.ts\" --max-warnings=0",
    "lint:js": "npm run lint --workspaces --if-present",
    "lint:py": "sh scripts/lint-py.sh",
    "lint": "npm run lint:root && npm run lint:js && npm run lint:py",
    "typecheck": "tsc -p tsconfig.json && npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "playwright test --grep-invert @live",
    "test:e2e:live": "playwright test",
    "ci": "npm run lint && npm run typecheck && npm run test",
    "prepare": "husky"
  },
  "dependencies": {
    "tsx": "^4.23.12"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.4.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint": "^10.8.1",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.1"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "esbuild@0.28.1": true
  }
}
