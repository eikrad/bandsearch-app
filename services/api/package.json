{
  "name": "@bandsearch/api",
  "version": "0.4.2",
  "private": true,
  "description": "Bandsearch Express API",
  "scripts": {
    "start": "tsx src/server.ts",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\" \"scripts/**/*.ts\" --max-warnings=0 --no-error-on-unmatched-pattern",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test",
    "migrate": "tsx scripts/migrate.ts",
    "migrate:turso": "tsx scripts/migrate.ts --turso",
    "create-user": "tsx scripts/create-user.ts",
    "invite:create": "tsx scripts/admin.ts invite:create",
    "invite:list": "tsx scripts/admin.ts invite:list",
    "invite:revoke": "tsx scripts/admin.ts invite:revoke",
    "user:disable": "tsx scripts/admin.ts user:disable",
    "user:enable": "tsx scripts/admin.ts user:enable"
  },
  "dependencies": {
    "@langchain/core": "^1.2.14",
    "@langchain/google-genai": "^2.3.0",
    "@langchain/langgraph": "^1.4.13",
    "@langchain/openai": "^1.6.2",
    "@libsql/client": "^0.18.0",
    "@tursodatabase/sync": "^0.7.2",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.3",
    "zod": "^4.6.5"
  }
}
