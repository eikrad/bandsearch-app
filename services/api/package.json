{
  "name": "@bandsearch/api",
  "version": "0.4.0-alpha.0",
  "private": true,
  "description": "Bandsearch Express API",
  "scripts": {
    "start": "tsx src/server.ts",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\" \"scripts/**/*.ts\" --max-warnings=0 --no-error-on-unmatched-pattern",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsx --test",
    "migrate": "tsx scripts/migrate.ts",
    "migrate:turso": "tsx scripts/migrate.ts --turso",
    "create-user": "tsx scripts/create-user.ts"
  },
  "dependencies": {
    "@langchain/langgraph": "^1.4.12",
    "@langchain/google-genai": "^2.3.0",
    "@libsql/client": "^0.17.4",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.2.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.22.0",
    "zod": "^4.4.3"
  }
}
