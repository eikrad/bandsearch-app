{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Primary window: chat UI and settings IPC",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "allow-llm-config-status",
    "allow-save-llm-api-key",
    "allow-save-brave-api-key",
    "allow-save-turso-config",
    "allow-clear-turso-config",
    "allow-save-api-endpoint-url",
    "allow-complete-onboarding",
    "allow-install-update",
    "opener:allow-open-url",
    "opener:allow-default-urls"
  ]
}
