{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bandsearch",
  "version": "0.4.0",
  "identifier": "app.bandsearch",
  "build": {
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run build:watch --workspace @bandsearch/desktop",
    "beforeBuildCommand": "npm run build --workspace @bandsearch/desktop"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Bandsearch",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "externalBin": ["binaries/node"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJBMENBQTkyQ0M3NTYzNDAKUldSQVkzWE1rcW9NS3AwOFpHWmdFTHRiRHBOMFBTUUdSbk5UMjdkNFFtR3V5dW5FMUlvckNFVHoK",
      "endpoints": [
        "https://github.com/eikrad/bandsearch-app/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
